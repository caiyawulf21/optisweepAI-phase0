# Cosmos-only runtime configuration
# Copy into app repo .env

# --- REQUIRED: Cosmos connection ---
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_KEY=<key>
COSMOS_DATABASE=<database>

COSMOS_CONTAINER_RUNBOOKS=<container>
COSMOS_CONTAINER_PLAYBOOKS_A=<container>
COSMOS_CONTAINER_PLAYBOOKS_B=<container>
COSMOS_CONTAINER_RELATIONSHIP_LINKS=<container>
COSMOS_CONTAINER_SOURCE_ARTIFACTS=<container>
COSMOS_CONTAINER_OPERATIONAL_CONTEXT=<container>
COSMOS_CONTAINER_CANONICAL_IMAGES=publish_canonical_images
COSMOS_CONTAINER_GATE_PHRASE_TABLES=gate_phrase_tables

AZURE_STORAGE_CONNECTION_STRING=<storage-connection-string>
AZURE_CANONICAL_IMAGES_CONTAINER=canonical-images
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net

# Copy from ingestion stage_11 publish_manifest.json / docs/app_agent_scoring_handoff.md
PUBLISH_VERSION_ID=publish_20260714_172351_09e54f8f

# --- REQUIRED: query embedding (must match Stage 10 embedding_model) ---
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Orchestration (Cosmos playbook runtime only) ---
RETRIEVAL_BACKEND=cosmos
USE_PLAYBOOK_ORCHESTRATION=true
ENABLE_CANONICAL_WORKFLOW_RUNTIME=true
SKIP_PLAYBOOK_CONFIRMATION=true
PLAYBOOK_MATCH_THRESHOLD=0.80
PLAYBOOK_HIGH_CONFIDENCE_THRESHOLD=0.90
PLAYBOOK_PIN_COVERAGE_THRESHOLD=0.40
DEFAULT_PLAYBOOK_VARIANT=prompt_a

# --- Off / deleted ---
# USE_CANONICAL_ROUTING=false          # YAML router — DELETE code, not flag
# ENABLE_DYNAMIC_PROCEDURE_GUIDANCE    # DELETE
# ENABLE_LEGACY_WORKFLOW               # DELETE
# ENABLE_LLM_WORKFLOW_REASONING        # DELETE
# ENABLE_LLM_SYMPTOM_EXTRACTION=true
# ENABLE_SEMANTIC_SIGNAL_PRIOR=false
# RETRIEVAL_BACKEND=local|local_files|azure_search|local_bm25_agent  # DELETE
# LOCAL_CORPUS_PATH                    # DELETE

# --- Session ---
SESSION_BACKEND=memory
