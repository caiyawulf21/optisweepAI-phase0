# =============================================================================
# OptiSweep AI Support Assistant — AGENT ENV MOCK
# =============================================================================
# PURPOSE
#   Machine- and agent-readable inventory of every environment key this app
#   reads to boot and run. Copy to `.env` (gitignored) and replace MOCK_* /
#   empty placeholders with real values. Do NOT commit secrets.
#
# HOW TO USE (agent)
#   1. Read this file top-to-bottom; respect REQUIRED vs OPTIONAL sections.
#   2. Provision Azure resources per AZURE_ACCOUNT_HANDOFF.md.
#   3. Fill secrets from Key Vault / portal; keep container names unless
#      ingestion Stage 11 published under different names.
#   4. Write filled values to repo-root `.env` (never overwrite this mock).
#   5. Validate: python scripts/preflight_deployment.py
#                python -m backend.app.scripts.verify_cosmos_corpus
#   6. Health: GET /health → embedding_total > 0 and publish_version_id set.
#
# RELATED
#   .env.example              — shorter human template (same keys, less prose)
#   config/feature_flags.env.example — older partial snippet; prefer this file
#   AZURE_ACCOUNT_HANDOFF.md  — provision order + Key Vault secretRef names
#   docs/INGESTION_DEPENDENCIES.md — corpus / Brain ownership boundary
#   deploy/container-app.yaml — production env + secretRef mapping
#
# ALIASES (either name works; prefer the COSMOS_* / AZURE_* form shown first)
#   COSMOS_ENDPOINT          ↔ AZURE_COSMOS_ENDPOINT
#   COSMOS_KEY               ↔ AZURE_COSMOS_KEY
#   COSMOS_DATABASE          ↔ AZURE_COSMOS_DATABASE_NAME
#   AZURE_VISION_ENDPOINT    ↔ AZURE_COMPUTER_VISION_ENDPOINT
#   AZURE_VISION_KEY         ↔ AZURE_COMPUTER_VISION_KEY
#   AZURE_EMBEDDINGS_*       falls back to AZURE_OPENAI_* when unset
#
# CONTAINER APP secretRef (Key Vault) names ≠ env var names:
#   cosmos-endpoint          → COSMOS_ENDPOINT
#   cosmos-key               → COSMOS_KEY
#   azure-openai-endpoint    → AZURE_OPENAI_ENDPOINT
#   azure-openai-api-key     → AZURE_OPENAI_API_KEY
#   azure-openai-deployment  → AZURE_OPENAI_DEPLOYMENT
# =============================================================================


# -----------------------------------------------------------------------------
# 0. PROCESS / LOCAL DEV (always set for local + Container App)
# -----------------------------------------------------------------------------
# APP_ENV: local | demo | preview. demo triggers preflight REQUIRED_DEMO_ENV.
APP_ENV=demo
LOG_LEVEL=INFO
# Streamlit → FastAPI. In Container App both share the pod; keep loopback.
API_BASE_URL=http://127.0.0.1:8000
# Container App only (scripts/start_azure_container_app.py)
PORT=8501
BACKEND_PORT=8000
PYTHONPATH=.
DEMO_MODE=true


# -----------------------------------------------------------------------------
# 1. RUNTIME BACKENDS (REQUIRED for live demo; stub/memory OK for unit tests)
# -----------------------------------------------------------------------------
# Valid: RETRIEVAL_BACKEND = cosmos | stub
# Valid: SESSION_BACKEND = cosmos | memory
# Valid: INTERACTION_LOG_BACKEND = cosmos | memory | disabled
# Valid: FEEDBACK_BACKEND = cosmos | memory | disabled
# If COSMOS_ENDPOINT+COSMOS_KEY present and these unset → defaults to cosmos.
RETRIEVAL_BACKEND=cosmos
SESSION_BACKEND=cosmos
INTERACTION_LOG_BACKEND=cosmos
FEEDBACK_BACKEND=cosmos
# Runtime memory containers are CODE-FIXED (not env):
#   SESSION_BACKEND=cosmos           → workflow_sessions, PK /session_id
#   INTERACTION_LOG_BACKEND=cosmos   → interaction_logs, PK /session_id
#   FEEDBACK_BACKEND=cosmos          → feedback_events, PK /session_id
# CORPUS_DEV_FALLBACK: deploy YAML sets disabled (do not rely on sample corpus).
CORPUS_DEV_FALLBACK=disabled


# -----------------------------------------------------------------------------
# 2. COSMOS DB — CONNECTION (REQUIRED when any backend = cosmos)
# -----------------------------------------------------------------------------
# SOURCE: Azure Portal → Cosmos account → Keys
# SHAPE: endpoint is HTTPS URL; key is master key string (never a URL).
COSMOS_ENDPOINT=https://MOCK_COSMOS_ACCOUNT.documents.azure.com:443/
COSMOS_KEY=MOCK_COSMOS_PRIMARY_KEY_BASE64_LOOKING_STRING
COSMOS_DATABASE=optisweep_knowledge_phase0


# -----------------------------------------------------------------------------
# 3. COSMOS — KNOWLEDGE CONTAINERS (REQUIRED names must match Stage 11 publish)
# -----------------------------------------------------------------------------
# SOURCE: ingestion publish_manifest.json / docs/cosmos_data_map.md
# PK for knowledge containers: /publish_version_id
# preflight_deployment.py asserts these default names when APP_ENV=demo.
COSMOS_CONTAINER_RUNBOOKS=runbooks
COSMOS_CONTAINER_PLAYBOOKS_A=playbooks_prompt_a
COSMOS_CONTAINER_PLAYBOOKS_B=playbooks_prompt_b
COSMOS_CONTAINER_OPERATIONAL_CONTEXT=operational_context
COSMOS_CONTAINER_RELATIONSHIP_LINKS=relationship_links
COSMOS_CONTAINER_SOURCE_ARTIFACTS=source_artifacts
COSMOS_CONTAINER_CANONICAL_IMAGES=publish_canonical_images
COSMOS_CONTAINER_GATE_PHRASE_TABLES=gate_phrase_tables


# -----------------------------------------------------------------------------
# 4. PUBLISH VERSION (REQUIRED for non-empty retrieval)
# -----------------------------------------------------------------------------
# SOURCE: ingestion Stage 11 publish_manifest.json → publish_version_id
# Prefer AUTO_PUBLISH_VERSION=true (startup picks newest publish with embeddings).
# Pin only when you need a frozen corpus:
AUTO_PUBLISH_VERSION=true
PUBLISH_VERSION_ID=publish_YYYYMMDD_HHMMSS_MOCKHASH


# -----------------------------------------------------------------------------
# 5. AZURE OPENAI — CHAT + EMBEDDINGS (REQUIRED for demo / LLM agents)
# -----------------------------------------------------------------------------
# SOURCE: Azure AI Foundry / OpenAI resource → Keys and Endpoint; Deployments blade
# CRITICAL: AZURE_EMBEDDINGS_DEPLOYMENT + dims MUST match ingestion Stage 10
#           embedding_model (usually text-embedding-3-small @ 1536).
# APP_ENV=demo preflight requires all of: ENDPOINT, API_KEY, DEPLOYMENT,
#   API_VERSION, EMBEDDINGS_DEPLOYMENT, EMBEDDING_DIMENSIONS.
AZURE_OPENAI_ENDPOINT=https://MOCK_OPENAI_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=MOCK_AZURE_OPENAI_KEY
AZURE_OPENAI_DEPLOYMENT=MOCK_CHAT_DEPLOYMENT_NAME
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_DIMENSIONS=1536
AZURE_SEARCH_VECTOR_DIMENSIONS=1536
# Optional overrides (default = OpenAI endpoint/key/version above):
# AZURE_EMBEDDINGS_ENDPOINT=
# AZURE_EMBEDDINGS_API_KEY=
# AZURE_EMBEDDINGS_API_VERSION=
# AZURE_COSMOS_VECTOR_DIMENSIONS=1536
# Local-only fallback (not for demo): FORCE_LOCAL_EMBEDDINGS=false
# LOCAL_EMBEDDINGS_MODEL=


# -----------------------------------------------------------------------------
# 6. BLOB STORAGE (REQUIRED for canonical images + user attachments)
# -----------------------------------------------------------------------------
# SOURCE: Storage account → Access keys / Endpoints
# Need ONE of connection string OR account URL (+ RBAC / key as used by SDK).
AZURE_STORAGE_ACCOUNT_URL=https://MOCK_STORAGE_ACCOUNT.blob.core.windows.net
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=MOCK_STORAGE_ACCOUNT;AccountKey=MOCK_KEY;EndpointSuffix=core.windows.net
# Blob container for playbook/runbook images (maps to Cosmos publish_canonical_images)
AZURE_CANONICAL_IMAGES_CONTAINER=canonical-images
# Blob container for user-uploaded images (feedback / troubleshoot attachments)
AZURE_USER_ATTACHMENTS_CONTAINER=user-interaction-attachments
# Ingestion-side containers (optional for this app runtime; used by some scripts):
AZURE_RAW_ARTIFACTS_CONTAINER=raw-source-artifacts
AZURE_PROCESSED_ARTIFACTS_CONTAINER=processed-source-artifacts


# -----------------------------------------------------------------------------
# 7. AZURE AI VISION (OPTIONAL — attachments image_summary path)
# -----------------------------------------------------------------------------
# SOURCE: Computer Vision / AI Vision resource → Keys and Endpoint
# Without these, text-only feedback still works; image upload summarization fails.
AZURE_VISION_ENDPOINT=https://MOCK_VISION_RESOURCE.cognitiveservices.azure.com/
AZURE_VISION_KEY=MOCK_VISION_KEY
AZURE_VISION_API_VERSION=2024-02-01


# -----------------------------------------------------------------------------
# 8. PLAYBOOK ORCHESTRATION THRESHOLDS
# -----------------------------------------------------------------------------
DEFAULT_PLAYBOOK_VARIANT=prompt_a
PLAYBOOK_MATCH_THRESHOLD=0.80
PLAYBOOK_HIGH_CONFIDENCE_THRESHOLD=0.90
PLAYBOOK_PIN_COVERAGE_THRESHOLD=0.40
SKIP_PLAYBOOK_CONFIRMATION=true
# Legacy/alias seen in older snippets (not primary AppSettings field):
# USE_PLAYBOOK_ORCHESTRATION=true


# -----------------------------------------------------------------------------
# 9. LLM AGENT FEATURE FLAGS
# -----------------------------------------------------------------------------
# true/false/1/0/yes/on — when true, need AZURE_OPENAI_* chat deployment.
ENABLE_LLM_BRANCH_MATCH=true
ENABLE_LLM_RETRIEVE_SYNTHESIS=true
ENABLE_LLM_ORCHESTRATOR=true
ENABLE_LLM_SYMPTOM_EXTRACTION=true
ENABLE_SEMANTIC_SIGNAL_PRIOR=false


# -----------------------------------------------------------------------------
# 10. BRAIN HTTP CLIENT (OPTIONAL — owned by ingestion, not this repo)
# -----------------------------------------------------------------------------
# SOURCE: ingestion Brain Container App FQDN (coordinate; do not invent)
# Defaults in code are OFF. Live deploy/container-app.yaml turns routes ON.
# Master switch + per-route flags; all require a reachable BRAIN_HTTP_BASE_URL.
BRAIN_HTTP_BASE_URL=https://MOCK-brain-http.REGION.azurecontainerapps.io
BRAIN_HTTP_ENABLED=false
BRAIN_HTTP_RETRIEVE=false
BRAIN_HTTP_TROUBLESHOOT=false
BRAIN_HTTP_FEEDBACK=false
BRAIN_HTTP_REVIEWS=false
BRAIN_HTTP_TIMEOUT_SECONDS=90
# Background cold-start probe on API startup when retrieve/troubleshoot on.
BRAIN_HTTP_WARMUP_ON_STARTUP=true


# -----------------------------------------------------------------------------
# 11. AZURE AI SEARCH (OPTIONAL / LEFTOVER — not required for cosmos retrieval)
# -----------------------------------------------------------------------------
# Current live path is RETRIEVAL_BACKEND=cosmos. Keep unset unless a Search
# index path is intentionally re-enabled.
# AZURE_SEARCH_ENDPOINT=https://MOCK_SEARCH.search.windows.net
# AZURE_SEARCH_KEY=MOCK_SEARCH_ADMIN_KEY
# AZURE_SEARCH_INDEX_NAME=idx-optisweep-phase0-knowledge


# -----------------------------------------------------------------------------
# 12. TESTS / ONE-OFFS (do not set in production Container App)
# -----------------------------------------------------------------------------
# COSMOS_E2E=1
#   → enables tests/test_cosmos_corpus_integration.py against live Cosmos


# -----------------------------------------------------------------------------
# MINIMUM CHECKLIST FOR A WORKING LIVE DEMO
# -----------------------------------------------------------------------------
# [ ] COSMOS_ENDPOINT + COSMOS_KEY + COSMOS_DATABASE
# [ ] Knowledge containers exist and Stage 11 published (embeddings present)
# [ ] AUTO_PUBLISH_VERSION=true OR valid PUBLISH_VERSION_ID
# [ ] AZURE_OPENAI_ENDPOINT + API_KEY + DEPLOYMENT + API_VERSION
# [ ] AZURE_EMBEDDINGS_DEPLOYMENT + AZURE_EMBEDDING_DIMENSIONS (match publish)
# [ ] RETRIEVAL_BACKEND=SESSION_BACKEND=INTERACTION_LOG_BACKEND=cosmos
# [ ] Storage URL or connection string + canonical-images container
# [ ] (Optional) Vision for image attachments
# [ ] (Optional) Brain URL + flags only after Brain is reachable
# =============================================================================
